<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="BrandPrimary">#342B9A</Color>
    <Color x:Key="BrandPrimaryDark">#29216F</Color>
    <Color x:Key="BrandPrimaryLight">#ECEAFF</Color>

    <Color x:Key="Canvas">#FFFFFF</Color>
    <Color x:Key="CanvasMuted">#F7F7FA</Color>
    <Color x:Key="CanvasSubtle">#F1F1F5</Color>
    <Color x:Key="BorderSubtle">#D7D7D7</Color>
    <Color x:Key="BorderStrong">#BEBEC7</Color>

    <Color x:Key="InkPrimary">#2C2C2C</Color>
    <Color x:Key="InkMuted">#5F5F66</Color>
    <Color x:Key="InkSoft">#787880</Color>

    <Color x:Key="SuccessColor">#1D6B43</Color>
    <Color x:Key="ErrorColor">#AB231E</Color>
    <Color x:Key="PlaceholderSurface">#ECECF1</Color>

    <!-- Compatibility aliases -->
    <Color x:Key="Primary">#342B9A</Color>
    <Color x:Key="PrimaryDark">#29216F</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#ECEAFF</Color>
    <Color x:Key="SecondaryDarkText">#342B9A</Color>
    <Color x:Key="Tertiary">#2C2C2C</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#111111</Color>
    <Color x:Key="Magenta">#342B9A</Color>
    <Color x:Key="MidnightBlue">#342B9A</Color>
    <Color x:Key="OffBlack">#1B1B1F</Color>

    <Color x:Key="Gray100">#F7F7FA</Color>
    <Color x:Key="Gray200">#ECECF1</Color>
    <Color x:Key="Gray300">#D7D7D7</Color>
    <Color x:Key="Gray400">#BEBEC7</Color>
    <Color x:Key="Gray500">#787880</Color>
    <Color x:Key="Gray600">#5F5F66</Color>
    <Color x:Key="Gray900">#2C2C2C</Color>
    <Color x:Key="Gray950">#1B1B1F</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
    <SolidColorBrush x:Key="CanvasMutedBrush" Color="{StaticResource CanvasMuted}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMuted}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
