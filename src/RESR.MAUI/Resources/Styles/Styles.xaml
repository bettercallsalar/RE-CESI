<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource BorderSubtle}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="SurfaceBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="SubtleSurfaceBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CanvasMuted}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="CardSurfaceBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="FieldBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="FilledBadgeBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
    </Style>

    <Style x:Key="OutlineBadgeBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
    </Style>

    <Style x:Key="NeutralBadgeBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CanvasSubtle}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Stroke" Value="{StaticResource BorderSubtle}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{StaticResource BorderSubtle}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource Canvas}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CanvasSubtle}" />
                            <Setter Property="BorderColor" Value="{StaticResource BorderSubtle}" />
                            <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
    </Style>

    <Style x:Key="HeaderLinkButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource Canvas}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="SmallSecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource BrandPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkSoft}" />
        <Setter Property="MinimumHeightRequest" Value="120" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkSoft}" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="HeroTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style x:Key="CardTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="BodyMutedLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style x:Key="BodyLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.45" />
    </Style>

    <Style x:Key="MetaLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="FieldHintLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="ValueLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="StatusLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkMuted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="BadgeLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Canvas}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="OutlineBadgeLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="FooterTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource InkSoft}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkSoft}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource BorderStrong}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource InkSoft}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource InkSoft}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="BarTextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="IconColor" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Canvas}" />
        <Setter Property="BarTextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource InkSoft}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource BrandPrimary}" />
    </Style>

</ResourceDictionary>
