<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.MainPage"
             Title="Users API">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Users depuis l'API" Style="{StaticResource Headline}" />

        <HorizontalStackLayout Spacing="10">
            <Button x:Name="LoadButton"
                    Text="Charger"
                    Clicked="OnLoadClicked" />
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel"
               Text="Clique sur Charger pour appeler GET /api/users"
               LineBreakMode="WordWrap" />

        <CollectionView x:Name="UsersCollection"
                        HeightRequest="420"
                        EmptyView="Aucun user trouve.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            Margin="0,4"
                            Stroke="#D0D7DE"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Username}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" FontSize="12" />
                            <Label Text="{Binding Bio}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
