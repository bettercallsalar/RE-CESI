<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.MainPage"
             Title="Users API">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Users depuis l'API" Style="{StaticResource Headline}" />

        <Label Text="Inscription" FontAttributes="Bold" />
        <Entry x:Name="RegisterUsernameEntry"
               Placeholder="Username"
               Text="nouveau_user" />
        <Entry x:Name="RegisterFirstNameEntry"
               Placeholder="Prenom"
               Text="Nouveau" />
        <Entry x:Name="RegisterEmailEntry"
               Placeholder="Email"
               Text="nouveau.user@test.com"
               Keyboard="Email" />
        <Entry x:Name="RegisterPasswordEntry"
               Placeholder="Mot de passe"
               IsPassword="True" />
        <Entry x:Name="RegisterBirthDateEntry"
               Placeholder="Date de naissance (yyyy-MM-dd)"
               Text="2000-01-01" />
        <Entry x:Name="RegisterDepartmentEntry"
               Placeholder="Id department"
               Text="1"
               Keyboard="Numeric" />
        <Editor x:Name="RegisterBioEntry"
                Placeholder="Bio"
                AutoSize="TextChanges"
                HeightRequest="90"
                Text="Compte cree depuis MAUI." />
        <Button x:Name="RegisterButton"
                Text="Register"
                Clicked="OnRegisterClicked" />

        <BoxView HeightRequest="1" Opacity="0.2" />

        <Label Text="Connexion" FontAttributes="Bold" />
        <HorizontalStackLayout Spacing="10">
            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   Text="adrien.dev@test.com"
                   WidthRequest="220" />
            <Entry x:Name="PasswordEntry"
                   Placeholder="Mot de passe"
                   IsPassword="True"
                   WidthRequest="180" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Button x:Name="LoginButton"
                    Text="Login"
                    Clicked="OnLoginClicked" />
            <Button x:Name="LoadButton"
                    Text="Charger"
                    Clicked="OnLoadClicked" />
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Label Text="Token JWT" FontAttributes="Bold" />
        <Editor x:Name="TokenEditor"
                AutoSize="TextChanges"
                HeightRequest="120"
                IsReadOnly="True"
                Placeholder="Le token apparaitra ici apres connexion." />

        <Label x:Name="StatusLabel"
               Text="Connecte-toi puis clique sur Charger pour appeler GET /api/users"
               LineBreakMode="WordWrap" />

        <CollectionView x:Name="UsersCollection"
                        HeightRequest="420"
                        EmptyView="Aucun user trouve.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            Margin="0,4"
                            Stroke="#D0D7DE"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Username}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" FontSize="12" />
                            <Label Text="{Binding Bio}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
