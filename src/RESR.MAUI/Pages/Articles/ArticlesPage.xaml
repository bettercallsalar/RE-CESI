<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Articles.ArticlesPage"
             Title="Articles"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="RefreshContainer"
                 Refreshing="OnRefreshRequested">
        <Grid HorizontalOptions="Center"
              MaximumWidthRequest="1100"
              Padding="{OnIdiom Phone='18,16,18,24', Tablet='28,22,28,28', Default='34,24,34,32'}"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="16">

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                    <Button Clicked="OnBackClicked"
                            Style="{StaticResource SmallSecondaryButtonStyle}"
                            Text="Retour" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4">
                        <Label Style="{StaticResource PageTitleLabelStyle}"
                               Text="Articles" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Parcourez les articles publics approuves." />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <SearchBar x:Name="KeywordSearchBar"
                                   Placeholder="Rechercher un article"
                                   SearchButtonPressed="OnSearchSubmitted"
                                   TextChanged="OnSearchTextChanged" />
                    </Border>

                    <Button x:Name="SearchButton"
                            Grid.Column="1"
                            Clicked="OnSearchButtonClicked"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            Text="Rechercher" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource SubtleSurfaceBorderStyle}">
                <HorizontalStackLayout Spacing="10"
                                       VerticalOptions="Center">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False" />
                    <Label x:Name="StatusLabel"
                           Style="{StaticResource StatusLabelStyle}"
                           Text="Chargement des articles..." />
                </HorizontalStackLayout>
            </Border>

            <Grid Grid.Row="3">
                <CollectionView x:Name="ArticlesCollectionView"
                                IsVisible="False"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border SemanticProperties.Description="{Binding AccessibilityText}"
                                    Style="{StaticResource CardSurfaceBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticleTapped" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="150,*">
                                    <Grid BackgroundColor="{StaticResource PlaceholderSurface}"
                                          Padding="18">
                                        <Image Aspect="AspectFill"
                                               IsVisible="{Binding HasImage}"
                                               Source="{Binding ImageSource}" />
                                        <BoxView Color="#22000000"
                                                 IsVisible="{Binding HasImage}" />
                                        <Grid RowDefinitions="Auto,*"
                                              RowSpacing="12">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10">
                                                <Border Style="{StaticResource FilledBadgeBorderStyle}">
                                                    <Label Style="{StaticResource BadgeLabelStyle}"
                                                           Text="{Binding Badge}" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        BackgroundColor="#66000000"
                                                        HorizontalOptions="End"
                                                        Padding="10,4"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999">
                                                    <Label HorizontalTextAlignment="End"
                                                           Style="{StaticResource BadgeLabelStyle}"
                                                           Text="{Binding DateLabel}" />
                                                </Border>
                                            </Grid>

                                            <Label Grid.Row="1"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="{OnIdiom Phone='26', Default='30'}"
                                                   HorizontalOptions="Center"
                                                   IsVisible="{Binding ShowImagePlaceholder}"
                                                   Opacity="0.28"
                                                   Text="{Binding Eyebrow}"
                                                   TextColor="{StaticResource BrandPrimary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1"
                                                         Padding="18"
                                                         Spacing="10">
                                        <VerticalStackLayout Spacing="6">
                                            <Label FontFamily="OpenSansSemibold"
                                                   FontSize="{OnIdiom Phone='15', Default='17'}"
                                                   Opacity="0.55"
                                                   Text="{Binding Eyebrow}"
                                                   TextColor="{StaticResource BrandPrimary}" />
                                            <Label Style="{StaticResource CardTitleLabelStyle}"
                                                   Text="{Binding Title}" />
                                        </VerticalStackLayout>
                                        <Label IsVisible="{Binding HasSubtitle}"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding Subtitle}" />
                                        <Label Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding Meta}" />
                                        <Label LineBreakMode="TailTruncation"
                                               MaxLines="5"
                                               Style="{StaticResource BodyLabelStyle}"
                                               Text="{Binding Summary}" />
                                        <Button Clicked="OnArticleOpenClicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                                Text="Lire l'article" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="EmptyState"
                        IsVisible="False"
                        Style="{StaticResource SurfaceBorderStyle}">
                    <Label HorizontalTextAlignment="Center"
                           Style="{StaticResource BodyMutedLabelStyle}"
                           Text="Aucun article public disponible." />
                </Border>
            </Grid>

            <Button x:Name="LoadMoreButton"
                    Grid.Row="4"
                    Clicked="OnLoadMoreClicked"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="Charger plus" />
        </Grid>
    </RefreshView>
</ContentPage>
