<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Articles.CreateArticlePage"
             Title="Nouvel article"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             MaximumWidthRequest="860"
                             Padding="{OnIdiom Phone='18,16,18,26', Tablet='28,22,28,30', Default='34,24,34,34'}"
                             Spacing="18">

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                    <Button Clicked="OnBackClicked"
                            Style="{StaticResource SmallSecondaryButtonStyle}"
                            Text="Retour" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4">
                        <Label Style="{StaticResource PageTitleLabelStyle}"
                               Text="Publier un article" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Renseignez les informations de publication." />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource SectionTitleLabelStyle}"
                               Text="Nouvel article" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Completez les champs obligatoires avant publication." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Titre" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry x:Name="TitleEntry"
                                   MaxLength="50"
                                   Placeholder="Titre de l'article"
                                   TextChanged="OnTitleChanged" />
                        </Border>
                        <Label x:Name="TitleCounterLabel"
                               Style="{StaticResource FieldHintLabelStyle}"
                               Text="0/50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Visibilite" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Picker x:Name="VisibilityPicker"
                                    Title="Choisir une visibilite" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Categorie" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Picker x:Name="CategoryPicker"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Categories}"
                                    Title="Choisir une categorie" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Description" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Editor x:Name="DescriptionEditor"
                                    AutoSize="TextChanges"
                                    HeightRequest="140"
                                    MaxLength="5000"
                                    Placeholder="Resume de l'article" />
                        </Border>
                        <Label Style="{StaticResource FieldHintLabelStyle}"
                               Text="Limite : 5000 caracteres." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Contenu" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Editor x:Name="ContentEditor"
                                    AutoSize="TextChanges"
                                    HeightRequest="240"
                                    Placeholder="Ecrivez votre article ici..." />
                        </Border>
                        <Label Style="{StaticResource FieldHintLabelStyle}"
                               Text="Le contenu est obligatoire." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Images" />
                        <Button x:Name="PickImagesButton"
                                Clicked="OnPickImagesClicked"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="Ajouter des images" />
                        <Label Style="{StaticResource FieldHintLabelStyle}"
                               Text="Jusqu'a 6 images, 5 Mo maximum par image." />

                        <CollectionView x:Name="SelectedImagesView"
                                        HeightRequest="180"
                                        IsVisible="False"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleSurfaceBorderStyle}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Style="{StaticResource ValueLabelStyle}"
                                                   Text="{Binding FileName}" />
                                            <Label Style="{StaticResource BodyMutedLabelStyle}"
                                                   Text="{Binding Description}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border x:Name="DefaultImageContainer"
                                IsVisible="False"
                                Style="{StaticResource SubtleSurfaceBorderStyle}">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource FieldLabelStyle}"
                                       Text="Image par defaut" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Picker x:Name="DefaultImagePicker"
                                            ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding DefaultImageOptions}"
                                            SelectedIndexChanged="OnDefaultImageChanged"
                                            Title="Choisir l'image par defaut" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           Style="{StaticResource StatusLabelStyle}"
                           Text="Renseignez les champs obligatoires." />

                    <Button x:Name="CreateButton"
                            Clicked="OnCreateClicked"
                            Text="Publier l'article" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
