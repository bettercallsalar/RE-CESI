<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Articles.ArticleDetailPage"
             Title="Detail article"
             BackgroundColor="#F4F1EC">

    <ContentPage.Resources>
        <Style x:Key="HeroTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="MetaStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#2C2C2C" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="MarkButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="#342B9A" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="BorderColor" Value="#342B9A" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,28', Tablet='28,22,28,32', Default='36,26,36,40'}"
                             Spacing="18"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="980">

            <Border BackgroundColor="White"
                    Padding="{OnIdiom Phone='18', Default='24'}"
                    Stroke="#D7D7D7"
                    StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="StatusLabel"
                           Text="Chargement de l'article..."
                           Style="{StaticResource MetaStyle}" />

                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TitleLabel"
                               Text="Article"
                               Style="{StaticResource HeroTitleStyle}" />

                        <Label x:Name="MetaLabel"
                               Style="{StaticResource MetaStyle}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout x:Name="MarkActionsLayout"
                                           Spacing="10">
                        <Button x:Name="FavoriteButton"
                                Text="⭐ Favori"
                                Style="{StaticResource MarkButtonStyle}"
                                Clicked="OnFavoriteClicked" />
                        <Button x:Name="ReadLaterButton"
                                Text="🔖 Lire plus tard"
                                Style="{StaticResource MarkButtonStyle}"
                                Clicked="OnReadLaterClicked" />
                    </HorizontalStackLayout>

                    <Label x:Name="MarkHintLabel"
                           Style="{StaticResource MetaStyle}" />

                    <Border x:Name="DescriptionCard"
                            IsVisible="False"
                            BackgroundColor="#F8F8FB"
                            Stroke="#D7D7D7"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">
                        <Label x:Name="DescriptionLabel"
                               Style="{StaticResource BodyStyle}" />
                    </Border>

                    <BoxView HeightRequest="1"
                             Color="#D7D7D7" />

                    <Label x:Name="ContentLabel"
                           Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
