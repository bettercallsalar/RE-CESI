<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Articles.ArticleDetailPage"
             Title="Article"
             BackgroundColor="#F4F1EC">

    <ContentPage.Resources>
        <Style x:Key="FormHeroTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <Style x:Key="FormHeroSubtitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <Style x:Key="FormCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E5E0DA" />
            <Setter Property="StrokeShape" Value="RoundRectangle 26" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="FormSectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="FormCaptionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FormStatusLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="CommentAuthorStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="CommentMetaStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CommentBodyStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#2F2B4C" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="CommentActionButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextColor" Value="#2E2AA5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             MaximumWidthRequest="920"
                             Padding="{OnIdiom Phone='20,18,20,28', Tablet='28,22,28,32', Default='34,24,34,36'}"
                             Spacing="20">

            <VerticalStackLayout Spacing="6">
                <Label Text="Lecture d'article"
                       Style="{StaticResource FormHeroTitleStyle}" />
                <Label x:Name="HeaderCaptionLabel"
                       Text="Chargement du contenu..."
                       Style="{StaticResource FormHeroSubtitleStyle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FormCardStyle}">
                <VerticalStackLayout Spacing="18">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <VerticalStackLayout x:Name="ArticleContentLayout"
                                         Spacing="16"
                                         IsVisible="False">
                        <Border BackgroundColor="#2E2AA5"
                                HorizontalOptions="Start"
                                Padding="10,4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="Article public"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>

                        <Label x:Name="TitleLabel"
                               Style="{StaticResource FormSectionTitleStyle}"
                               FontSize="30" />

                        <Label x:Name="MetaLabel"
                               Style="{StaticResource FormCaptionStyle}" />

                        <Label x:Name="DescriptionLabel"
                               Style="{StaticResource FormStatusLabelStyle}"
                               IsVisible="False" />

                        <BoxView HeightRequest="1"
                                 Color="#E5E0DA" />

                        <Label x:Name="ContentLabel"
                               Style="{StaticResource FormStatusLabelStyle}"
                               FontSize="15"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           Text="Chargement de l'article..."
                           Style="{StaticResource FormStatusLabelStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CommentsCard"
                    Style="{StaticResource FormCardStyle}"
                    IsVisible="False">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Discussion"
                                   Style="{StaticResource FormSectionTitleStyle}" />
                            <Label x:Name="CommentsSummaryLabel"
                                   Text="Chargement des commentaires..."
                                   Style="{StaticResource FormCaptionStyle}" />
                        </VerticalStackLayout>

                        <Button x:Name="RefreshCommentsButton"
                                Grid.Column="1"
                                Text="Actualiser"
                                Clicked="OnRefreshCommentsClicked" />
                    </Grid>

                    <ActivityIndicator x:Name="CommentsLoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Border x:Name="ReplyTargetBorder"
                            IsVisible="False"
                            BackgroundColor="#F8F5F2"
                            Stroke="#E2DCD4"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <Label x:Name="ReplyTargetLabel"
                                   Style="{StaticResource FormStatusLabelStyle}" />
                            <Button x:Name="CancelReplyButton"
                                    Grid.Column="1"
                                    Text="Annuler"
                                    Clicked="OnCancelReplyClicked" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout x:Name="CommentComposerLayout"
                                         Spacing="10"
                                         IsVisible="False">
                        <Label x:Name="ComposerTitleLabel"
                               Text="Ajouter un commentaire"
                               Style="{StaticResource FormCaptionStyle}" />
                        <Editor x:Name="CommentEditor"
                                AutoSize="TextChanges"
                                Placeholder="Partagez votre avis sur cet article"
                                MinimumHeightRequest="120"
                                MaxLength="2000"
                                BackgroundColor="#FBFAF7"
                                TextColor="#1E1C44" />
                        <Button x:Name="PostCommentButton"
                                Text="Publier"
                                HorizontalOptions="Start"
                                Clicked="OnPostCommentClicked" />
                    </VerticalStackLayout>

                    <Border x:Name="CommentLoginHintBorder"
                            IsVisible="False"
                            BackgroundColor="#F8F5F2"
                            Stroke="#E2DCD4"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,10">
                        <Label Text="Connectez-vous pour publier un commentaire ou repondre a une discussion."
                               Style="{StaticResource FormStatusLabelStyle}" />
                    </Border>

                    <Label x:Name="CommentsStatusLabel"
                           Style="{StaticResource FormStatusLabelStyle}" />

                    <Label x:Name="NoCommentsLabel"
                           Text="Aucun commentaire pour le moment."
                           IsVisible="False"
                           Style="{StaticResource FormStatusLabelStyle}" />

                    <VerticalStackLayout x:Name="CommentsListLayout"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding CardBackgroundColor}"
                                        Stroke="{Binding CardStrokeColor}"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="16,14"
                                        Margin="{Binding IndentMargin}">
                                    <VerticalStackLayout Spacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding AuthorLabel}"
                                                   Style="{StaticResource CommentAuthorStyle}" />
                                            <Label Text="{Binding MetaLabel}"
                                                   Style="{StaticResource CommentMetaStyle}" />
                                        </VerticalStackLayout>

                                        <Label Text="{Binding DisplayContent}"
                                               Style="{StaticResource CommentBodyStyle}"
                                               TextColor="{Binding ContentTextColor}" />

                                        <HorizontalStackLayout Spacing="14">
                                            <Button Text="Repondre"
                                                    Clicked="OnReplyClicked"
                                                    IsVisible="{Binding CanReply}"
                                                    Style="{StaticResource CommentActionButtonStyle}" />
                                            <Button Text="{Binding ToggleRepliesLabel}"
                                                    Clicked="OnToggleRepliesClicked"
                                                    IsVisible="{Binding HasChildren}"
                                                    Style="{StaticResource CommentActionButtonStyle}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
