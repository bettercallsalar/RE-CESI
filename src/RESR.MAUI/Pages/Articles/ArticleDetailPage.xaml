<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Articles.ArticleDetailPage"
             Title="Article"
             BackgroundColor="#F4F1EC">

    <ContentPage.Resources>
        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E3DDD6" />
            <Setter Property="StrokeShape" Value="RoundRectangle 28" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="AuthorButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#2E2AA5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             MaximumWidthRequest="960"
                             Spacing="22"
                             Padding="{OnIdiom Phone='20,18,20,28', Tablet='30,24,30,34', Default='36,28,36,40'}">

            <VerticalStackLayout Spacing="6">
                <Label Text="Lecture"
                       Style="{StaticResource Headline}"
                       FontSize="{OnIdiom Phone='28', Default='34'}"
                       TextColor="#1E1C44" />
                <Label x:Name="HeaderCaptionLabel"
                       Text="Chargement de l'article..."
                       Style="{StaticResource SectionCaptionStyle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <VerticalStackLayout x:Name="ArticleContentLayout"
                                         IsVisible="False"
                                         Spacing="14">
                        <Border BackgroundColor="#2E2AA5"
                                HorizontalOptions="Start"
                                Padding="10,4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="Article"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>

                        <Label x:Name="TitleLabel"
                               Style="{StaticResource SectionTitleStyle}" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Par"
                                   Style="{StaticResource SectionCaptionStyle}" />
                            <Button x:Name="AuthorButton"
                                    Clicked="OnAuthorClicked"
                                    Style="{StaticResource AuthorButtonStyle}" />
                        </HorizontalStackLayout>

                        <Label x:Name="MetaLabel"
                               Style="{StaticResource SectionCaptionStyle}" />

                        <Label x:Name="DescriptionLabel"
                               IsVisible="False"
                               FontSize="15"
                               TextColor="#343052" />

                        <BoxView HeightRequest="1"
                                 Color="#E3DDD6" />

                        <Label x:Name="ContentLabel"
                               FontSize="15"
                               TextColor="#2C2C2C"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           Text="Chargement de l'article..."
                           Style="{StaticResource SectionCaptionStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
