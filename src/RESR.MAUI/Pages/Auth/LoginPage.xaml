<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Auth.LoginPage"
             Title="Connexion"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             MaximumWidthRequest="760"
                             Padding="{OnIdiom Phone='18,16,18,26', Tablet='28,22,28,30', Default='34,24,34,34'}"
                             Spacing="18">

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                    <Button Clicked="OnBackClicked"
                            Style="{StaticResource SmallSecondaryButtonStyle}"
                            Text="Retour" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4">
                        <Label Style="{StaticResource PageTitleLabelStyle}"
                               Text="Connexion" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Accedez a votre espace personnel depuis une interface claire et adaptee au tactile." />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource SectionTitleLabelStyle}"
                               Text="Se connecter" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Renseignez votre adresse email et votre mot de passe." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Courriel" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry x:Name="EmailEntry"
                                   Keyboard="Email"
                                   Placeholder="prenom.nom@exemple.fr" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabelStyle}"
                               Text="Mot de passe" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry x:Name="PasswordEntry"
                                   IsPassword="True"
                                   Placeholder="Votre mot de passe" />
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           Style="{StaticResource StatusLabelStyle}"
                           Text="Renseignez votre email et votre mot de passe." />

                    <Button x:Name="LoginButton"
                            Clicked="OnLoginClicked"
                            Text="Se connecter" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SubtleSurfaceBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource FieldLabelStyle}"
                           Text="Pas encore de compte ?" />
                    <Button Clicked="OnGoToRegisterClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="Creer un compte" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
