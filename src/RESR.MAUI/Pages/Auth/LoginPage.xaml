<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Auth.LoginPage"
             Title="Connexion"
             BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,24,20,30', Default='32,32,32,40'}"
                             Spacing="20"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="620">

            <VerticalStackLayout Spacing="6">
                <Label Text="Connexion"
                       Style="{StaticResource Headline}" />
                <Label Text="Retrouve ton espace RESR avec ton email et ton mot de passe."
                       Style="{StaticResource PageCaptionStyle}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource PageCardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Adresse email"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="EmailEntry"
                               Placeholder="nom@exemple.fr"
                               Keyboard="Email" />
                    </Border>

                    <Label Text="Mot de passe"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Mot de passe"
                               IsPassword="True" />
                    </Border>

                    <Button Text="Se connecter"
                            Clicked="OnLoginClicked" />

                    <Label x:Name="StatusLabel"
                           Text="Renseigne ton email et ton mot de passe."
                           Style="{StaticResource PageBodyTextStyle}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pas de compte ?"
                               Style="{StaticResource PageCaptionStyle}" />
                        <Button Text="Creer un compte"
                                Clicked="OnGoToRegisterClicked"
                                BackgroundColor="{StaticResource White}"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource Primary}"
                                BorderWidth="1" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
