<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Auth.RegisterPage"
             Title="Inscription"
             BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,24,20,30', Default='32,32,32,40'}"
                             Spacing="20"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="700">

            <VerticalStackLayout Spacing="6">
                <Label Text="Inscription"
                       Style="{StaticResource Headline}" />
                <Label Text="Cree un compte pour publier, reagir et suivre les ressources."
                       Style="{StaticResource PageCaptionStyle}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource PageCardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nom d'utilisateur"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="RegisterUsernameEntry"
                               Placeholder="Pseudo" />
                    </Border>

                    <Label Text="Prenom"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="RegisterFirstNameEntry"
                               Placeholder="Prenom" />
                    </Border>

                    <Label Text="Adresse email"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="RegisterEmailEntry"
                               Placeholder="nom@exemple.fr"
                               Keyboard="Email" />
                    </Border>

                    <Label Text="Mot de passe"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="RegisterPasswordEntry"
                               Placeholder="Mot de passe"
                               IsPassword="True" />
                    </Border>

                    <Label Text="Date de naissance"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Entry x:Name="RegisterBirthDateEntry"
                               Placeholder="JJ-MM-AAAA (optionnel)" />
                    </Border>

                    <Label Text="Departement"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,2">
                        <Picker x:Name="RegisterDepartmentPicker"
                                Title="Choisir un departement"
                                ItemsSource="{Binding Departments}"
                                ItemDisplayBinding="{Binding Name}" />
                    </Border>

                    <Label Text="Biographie"
                           Style="{StaticResource PageCaptionStyle}" />
                    <Border Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">
                        <Editor x:Name="RegisterBioEntry"
                                Placeholder="Quelques lignes sur toi (optionnel)"
                                AutoSize="TextChanges"
                                HeightRequest="110" />
                    </Border>

                    <Button Text="S'inscrire"
                            Clicked="OnRegisterClicked" />

                    <Label x:Name="StatusLabel"
                           Text="Renseigne les informations pour creer un compte."
                           Style="{StaticResource PageBodyTextStyle}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Deja un compte ?"
                               Style="{StaticResource PageCaptionStyle}" />
                        <Button Text="Se connecter"
                                Clicked="OnGoToLoginClicked"
                                BackgroundColor="{StaticResource White}"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource Primary}"
                                BorderWidth="1" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
