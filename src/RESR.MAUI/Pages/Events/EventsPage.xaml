<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Events.EventsPage"
             Title="Evenements"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="RefreshContainer"
                 Refreshing="OnRefreshRequested">
        <Grid HorizontalOptions="Center"
              MaximumWidthRequest="1100"
              Padding="{OnIdiom Phone='18,16,18,24', Tablet='28,22,28,28', Default='34,24,34,32'}"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="16">

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                    <Button Clicked="OnBackClicked"
                            Style="{StaticResource SmallSecondaryButtonStyle}"
                            Text="Retour" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4">
                        <Label Style="{StaticResource PageTitleLabelStyle}"
                               Text="Evenements" />
                        <Label Style="{StaticResource BodyMutedLabelStyle}"
                               Text="Retrouvez les evenements publics a venir dans une mise en page sobre et lisible." />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <SearchBar x:Name="KeywordSearchBar"
                                   Placeholder="Rechercher un evenement"
                                   SearchButtonPressed="OnSearchSubmitted"
                                   TextChanged="OnSearchTextChanged" />
                    </Border>

                    <Button x:Name="SearchButton"
                            Grid.Column="1"
                            Clicked="OnSearchButtonClicked"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            Text="Rechercher" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource SubtleSurfaceBorderStyle}">
                <HorizontalStackLayout Spacing="10"
                                       VerticalOptions="Center">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False" />
                    <Label x:Name="StatusLabel"
                           Style="{StaticResource StatusLabelStyle}"
                           Text="Chargement des evenements..." />
                </HorizontalStackLayout>
            </Border>

            <Grid Grid.Row="3">
                <CollectionView x:Name="EventsCollectionView"
                                IsVisible="False"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border SemanticProperties.Description="{Binding AccessibilityText}"
                                    Style="{StaticResource CardSurfaceBorderStyle}">
                                <Grid RowDefinitions="150,*">
                                    <Grid BackgroundColor="{StaticResource CanvasSubtle}"
                                          Padding="18">
                                        <Grid RowDefinitions="Auto,*"
                                              RowSpacing="12">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10">
                                                <Border Style="{StaticResource FilledBadgeBorderStyle}">
                                                    <Label Style="{StaticResource BadgeLabelStyle}"
                                                           Text="{Binding Badge}" />
                                                </Border>

                                                <Label Grid.Column="1"
                                                       HorizontalTextAlignment="End"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding DateLabel}" />
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Spacing="6"
                                                                 VerticalOptions="End">
                                                <Label FontFamily="OpenSansSemibold"
                                                       FontSize="{OnIdiom Phone='26', Default='30'}"
                                                       Opacity="0.32"
                                                       Text="{Binding Eyebrow}"
                                                       TextColor="{StaticResource BrandPrimary}" />
                                                <Label Style="{StaticResource CardTitleLabelStyle}"
                                                       Text="{Binding Title}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1"
                                                         Padding="18"
                                                         Spacing="10">
                                        <Label IsVisible="{Binding HasSubtitle}"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding Subtitle}" />
                                        <Label Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding Meta}" />
                                        <Label LineBreakMode="TailTruncation"
                                               MaxLines="5"
                                               Style="{StaticResource BodyLabelStyle}"
                                               Text="{Binding Summary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="EmptyState"
                        IsVisible="False"
                        Style="{StaticResource SurfaceBorderStyle}">
                    <Label HorizontalTextAlignment="Center"
                           Style="{StaticResource BodyMutedLabelStyle}"
                           Text="Aucun evenement public disponible." />
                </Border>
            </Grid>

            <Button x:Name="LoadMoreButton"
                    Grid.Row="4"
                    Clicked="OnLoadMoreClicked"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="Charger plus" />
        </Grid>
    </RefreshView>
</ContentPage>
