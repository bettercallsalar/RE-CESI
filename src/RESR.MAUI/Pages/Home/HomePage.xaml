<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Home.HomePage"
             Title="Accueil">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Bienvenue"
               Style="{StaticResource Headline}" />

        <Label Text="Choisis une action pour continuer." />

        <Button x:Name="LoginButton"
                Text="Connexion"
                Clicked="OnGoToLoginClicked" />

        <Button x:Name="RegisterButton"
                Text="Inscription"
                Clicked="OnGoToRegisterClicked" />

        <Button x:Name="ProfileButton"
                Text="Mon profil"
                Clicked="OnGoToProfileClicked"
                IsVisible="False" />

        <Button x:Name="CreateArticleButton"
                Text="Creer un article"
                Clicked="OnGoToCreateArticleClicked"
                IsVisible="False" />

        <Button x:Name="CreateEventButton"
                Text="Creer un evenement"
                Clicked="OnGoToCreateEventClicked"
                IsVisible="False" />
    </VerticalStackLayout>

</ContentPage>
