<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Home.MainPage"
             Title="Accueil"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="RefreshContainer"
                 Refreshing="OnRefreshRequested">
        <ScrollView>
            <VerticalStackLayout HorizontalOptions="Center"
                                 MaximumWidthRequest="1180"
                                 Padding="{OnIdiom Phone='18,16,18,28', Tablet='28,22,28,32', Default='36,26,36,40'}"
                                 Spacing="24">

                <Border Style="{StaticResource SurfaceBorderStyle}">
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          RowSpacing="16"
                          ColumnSpacing="16">

                        <VerticalStackLayout Spacing="6"
                                             WidthRequest="{OnIdiom Phone='106', Default='138'}">
                            <Grid ColumnDefinitions="12,12,12"
                                  ColumnSpacing="2"
                                  HorizontalOptions="Start">
                                <BoxView Grid.Column="0"
                                         Color="#2444D7"
                                         HeightRequest="10"
                                         WidthRequest="12" />
                                <BoxView Grid.Column="1"
                                         Color="#FFFFFF"
                                         HeightRequest="10"
                                         WidthRequest="12" />
                                <BoxView Grid.Column="2"
                                         Color="#E24242"
                                         HeightRequest="10"
                                         WidthRequest="12" />
                            </Grid>

                            <Label FontAttributes="Bold"
                                   FontSize="{OnIdiom Phone='9', Default='11'}"
                                   LineHeight="1.0"
                                   Text="MINISTERE&#10;DES SOLIDARITES&#10;ET DE LA SANTE"
                                   TextColor="{StaticResource InkPrimary}" />

                            <Label FontSize="{OnIdiom Phone='8', Default='10'}"
                                   Text="Liberte&#10;Egalite&#10;Fraternite"
                                   TextColor="{StaticResource InkSoft}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             HorizontalOptions="Center"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label FontSize="{OnIdiom Phone='21', Tablet='27', Default='31'}"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource PageTitleLabelStyle}"
                                   Text="(RE) Sources Relationnelles" />
                            <Label HorizontalTextAlignment="Center"
                                   Style="{StaticResource MetaLabelStyle}"
                                   Text="Articles et evenements publics" />
                        </VerticalStackLayout>

                        <Button x:Name="MenuButton"
                                Grid.Column="2"
                                Clicked="OnMenuClicked"
                                IsVisible="{OnIdiom Phone=True, Tablet=False, Default=False}"
                                SemanticProperties.Hint="Affiche les raccourcis de navigation"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="Menu"
                                VerticalOptions="Start" />

                        <HorizontalStackLayout Grid.Column="2"
                                               IsVisible="{OnIdiom Phone=False, Tablet=True, Default=True}"
                                               Spacing="2"
                                               VerticalOptions="Center">
                            <Button Clicked="OnArticlesNavigationClicked"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Articles" />
                            <Button Clicked="OnEventsNavigationClicked"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Evenements" />
                            <Button x:Name="HeaderRegisterButton"
                                    Clicked="OnRegisterNavigationClicked"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Inscription" />
                            <Button x:Name="HeaderCreateArticleButton"
                                    Clicked="OnCreateArticleNavigationClicked"
                                    IsVisible="False"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Publier" />
                            <Button x:Name="HeaderCreateEventButton"
                                    Clicked="OnCreateEventNavigationClicked"
                                    IsVisible="False"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Creer un evenement" />
                            <Button x:Name="HeaderLogoutButton"
                                    Clicked="OnLogoutNavigationClicked"
                                    IsVisible="False"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Deconnexion" />
                            <Button x:Name="HeaderAccountButton"
                                    Clicked="OnAccountNavigationClicked"
                                    Style="{StaticResource HeaderLinkButtonStyle}"
                                    Text="Connexion" />
                        </HorizontalStackLayout>

                        <Border x:Name="MobileMenuPanel"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                IsVisible="False"
                                Style="{StaticResource SubtleSurfaceBorderStyle}">
                            <VerticalStackLayout Spacing="8">
                                <Button Clicked="OnArticlesNavigationClicked"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Articles" />
                                <Button Clicked="OnEventsNavigationClicked"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Evenements" />
                                <Button x:Name="MobileRegisterButton"
                                        Clicked="OnRegisterNavigationClicked"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Inscription" />
                                <Button x:Name="MobileCreateArticleButton"
                                        Clicked="OnCreateArticleNavigationClicked"
                                        HorizontalOptions="Fill"
                                        IsVisible="False"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Publier un article" />
                                <Button x:Name="MobileCreateEventButton"
                                        Clicked="OnCreateEventNavigationClicked"
                                        HorizontalOptions="Fill"
                                        IsVisible="False"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Creer un evenement" />
                                <Button x:Name="MobileLogoutButton"
                                        Clicked="OnLogoutNavigationClicked"
                                        HorizontalOptions="Fill"
                                        IsVisible="False"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Deconnexion" />
                                <Button x:Name="MobileAccountButton"
                                        Clicked="OnAccountNavigationClicked"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="Connexion" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="{OnIdiom Phone='2,0', Default='8,2'}"
                                     Spacing="8">
                    <Label FontSize="{OnIdiom Phone='29', Tablet='35', Default='40'}"
                           Style="{StaticResource HeroTitleLabelStyle}"
                           Text="Bienvenue sur (RE) Sources Relationnelles !" />
                    <Label HorizontalTextAlignment="Center"
                           Style="{StaticResource BodyMutedLabelStyle}"
                           Text="Consultez les derniers articles et evenements publics." />
                </VerticalStackLayout>

                <Border Style="{StaticResource SubtleSurfaceBorderStyle}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <ActivityIndicator x:Name="LoadingIndicator"
                                               IsRunning="False"
                                               IsVisible="False"
                                               VerticalOptions="Center" />
                            <Label x:Name="StatusLabel"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Text="Chargement des ressources publiques..." />
                        </HorizontalStackLayout>

                        <Button x:Name="ReloadButton"
                                Grid.Column="1"
                                Clicked="OnRefreshButtonClicked"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="Actualiser" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource SectionTitleLabelStyle}"
                                   Text="Les derniers articles" />
                            <Label Style="{StaticResource BodyMutedLabelStyle}"
                                   Text="Les 5 derniers articles publies." />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Clicked="OnArticlesNavigationClicked"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="Voir tout" />
                    </Grid>

                    <Grid IsClippedToBounds="True">
                        <CarouselView x:Name="ArticleCarousel"
                                      HeightRequest="{OnIdiom Phone='360', Tablet='390', Default='410'}"
                                      IndicatorView="ArticleIndicator"
                                      IsBounceEnabled="False"
                                      IsVisible="False"
                                      Loop="False"
                                      PeekAreaInsets="0">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Border HorizontalOptions="Center"
                                            SemanticProperties.Description="{Binding AccessibilityText}"
                                            Style="{StaticResource CardSurfaceBorderStyle}"
                                            WidthRequest="{OnIdiom Phone='314', Tablet='520', Default='760'}">
                                        <Grid RowDefinitions="160,*">
                                            <Grid BackgroundColor="{StaticResource PlaceholderSurface}"
                                                  Padding="18">
                                                <Image Aspect="AspectFill"
                                                       IsVisible="{Binding HasImage}"
                                                       Source="{Binding ImageSource}" />
                                                <BoxView Color="#22000000"
                                                         IsVisible="{Binding HasImage}" />
                                                <Grid RowDefinitions="Auto,*"
                                                      RowSpacing="12">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">
                                                        <Border Style="{StaticResource FilledBadgeBorderStyle}">
                                                            <Label Style="{StaticResource BadgeLabelStyle}"
                                                                   Text="{Binding Badge}" />
                                                        </Border>

                                                        <Border Grid.Column="1"
                                                                BackgroundColor="#66000000"
                                                                HorizontalOptions="End"
                                                                Padding="10,4"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 999">
                                                            <Label HorizontalTextAlignment="End"
                                                                   Style="{StaticResource BadgeLabelStyle}"
                                                                   Text="{Binding DateLabel}" />
                                                        </Border>
                                                    </Grid>

                                                    <Label Grid.Row="1"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="{OnIdiom Phone='28', Default='34'}"
                                                           HorizontalOptions="Center"
                                                           IsVisible="{Binding ShowImagePlaceholder}"
                                                           Opacity="0.28"
                                                           Text="{Binding HeroCaption}"
                                                           TextColor="{StaticResource BrandPrimary}"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Padding="18"
                                                                 Spacing="10">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label FontFamily="OpenSansSemibold"
                                                           FontSize="{OnIdiom Phone='16', Default='18'}"
                                                           Opacity="0.55"
                                                           Text="{Binding HeroCaption}"
                                                           TextColor="{StaticResource BrandPrimary}" />
                                                    <Label Style="{StaticResource CardTitleLabelStyle}"
                                                           Text="{Binding Title}" />
                                                </VerticalStackLayout>
                                                <Label IsVisible="{Binding HasSubtitle}"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding Subtitle}" />
                                                <Label Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding Meta}" />
                                                <Label LineBreakMode="TailTruncation"
                                                       MaxLines="4"
                                                       Style="{StaticResource BodyLabelStyle}"
                                                       Text="{Binding Summary}" />
                                                <Button Clicked="OnArticleSeeMoreClicked"
                                                        HorizontalOptions="End"
                                                        SemanticProperties.Hint="Ouvre la liste complete des articles"
                                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                                        Text="{Binding ActionLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <Border x:Name="ArticleEmptyState"
                                IsVisible="False"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Label HorizontalTextAlignment="Center"
                                   Style="{StaticResource BodyMutedLabelStyle}"
                                   Text="Aucun article public disponible pour le moment." />
                        </Border>
                    </Grid>

                    <IndicatorView x:Name="ArticleIndicator"
                                   HorizontalOptions="Center"
                                   IndicatorSize="10"
                                   IsVisible="False"
                                   Margin="0,-2,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource SectionTitleLabelStyle}"
                                   Text="Les derniers evenements" />
                            <Label Style="{StaticResource BodyMutedLabelStyle}"
                                   Text="Les 5 derniers evenements publies." />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Clicked="OnEventsNavigationClicked"
                                Style="{StaticResource SmallSecondaryButtonStyle}"
                                Text="Voir tout" />
                    </Grid>

                    <Grid IsClippedToBounds="True">
                        <CarouselView x:Name="EventCarousel"
                                      HeightRequest="{OnIdiom Phone='388', Tablet='420', Default='440'}"
                                      IndicatorView="EventIndicator"
                                      IsBounceEnabled="False"
                                      IsVisible="False"
                                      Loop="False"
                                      PeekAreaInsets="0">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Border HorizontalOptions="Center"
                                            SemanticProperties.Description="{Binding AccessibilityText}"
                                            Style="{StaticResource CardSurfaceBorderStyle}"
                                            WidthRequest="{OnIdiom Phone='314', Tablet='520', Default='760'}">
                                        <Grid RowDefinitions="160,*">
                                            <Grid BackgroundColor="{StaticResource CanvasSubtle}"
                                                  Padding="18">
                                                <Grid RowDefinitions="Auto,*"
                                                      RowSpacing="12">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">
                                                        <Border Style="{StaticResource FilledBadgeBorderStyle}">
                                                            <Label Style="{StaticResource BadgeLabelStyle}"
                                                                   Text="{Binding Badge}" />
                                                        </Border>

                                                        <Label Grid.Column="1"
                                                               HorizontalTextAlignment="End"
                                                               Style="{StaticResource MetaLabelStyle}"
                                                               Text="{Binding DateLabel}" />
                                                    </Grid>

                                                    <VerticalStackLayout Grid.Row="1"
                                                                         Spacing="6"
                                                                         VerticalOptions="End">
                                                        <Label FontFamily="OpenSansSemibold"
                                                               FontSize="{OnIdiom Phone='28', Default='34'}"
                                                               Opacity="0.28"
                                                               Text="{Binding HeroCaption}"
                                                               TextColor="{StaticResource BrandPrimary}" />
                                                        <Label Style="{StaticResource CardTitleLabelStyle}"
                                                               Text="{Binding Title}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Padding="18"
                                                                 Spacing="10">
                                                <Label IsVisible="{Binding HasSubtitle}"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding Subtitle}" />
                                                <Label Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding Meta}" />
                                                <Label LineBreakMode="TailTruncation"
                                                       MaxLines="4"
                                                       Style="{StaticResource BodyLabelStyle}"
                                                       Text="{Binding Summary}" />
                                                <Button Clicked="OnEventSeeMoreClicked"
                                                        HorizontalOptions="End"
                                                        SemanticProperties.Hint="Ouvre la liste complete des evenements"
                                                        Style="{StaticResource SmallSecondaryButtonStyle}"
                                                        Text="{Binding ActionLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <Border x:Name="EventEmptyState"
                                IsVisible="False"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Label HorizontalTextAlignment="Center"
                                   Style="{StaticResource BodyMutedLabelStyle}"
                                   Text="Aucun evenement public disponible pour le moment." />
                        </Border>
                    </Grid>

                    <IndicatorView x:Name="EventIndicator"
                                   HorizontalOptions="Center"
                                   IndicatorSize="10"
                                   IsVisible="False"
                                   Margin="0,-2,0,0" />
                </VerticalStackLayout>

                <Border Margin="0,8,0,0"
                        Style="{StaticResource SurfaceBorderStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource FooterTitleLabelStyle}"
                               Text="Informations legales et contact" />
                        <Button Clicked="OnLegalNoticeClicked"
                                HorizontalOptions="Start"
                                Style="{StaticResource HeaderLinkButtonStyle}"
                                Text="Mentions legales" />
                        <Button Clicked="OnPrivacyCookiesClicked"
                                HorizontalOptions="Start"
                                Style="{StaticResource HeaderLinkButtonStyle}"
                                Text="Donnees personnelles et cookies" />
                        <Button Clicked="OnTermsOfUseClicked"
                                HorizontalOptions="Start"
                                Style="{StaticResource HeaderLinkButtonStyle}"
                                Text="Conditions generales d'utilisation" />
                        <Button Clicked="OnContactClicked"
                                HorizontalOptions="Start"
                                Style="{StaticResource HeaderLinkButtonStyle}"
                                Text="Contact" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
