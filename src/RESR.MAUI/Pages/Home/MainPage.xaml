<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Home.MainPage"
             Title="Ressources"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F1EC">

    <ContentPage.Resources>
        <Style x:Key="HeaderLinkLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#2E2AA5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#201B66" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1D1B43" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="2" />
        </Style>

        <Style x:Key="CardMetaStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#59567A" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CardSummaryStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#343052" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="4" />
        </Style>

        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#2E2AA5" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinimumHeightRequest" Value="34" />
            <Setter Property="MinimumWidthRequest" Value="44" />
        </Style>

    </ContentPage.Resources>

    <RefreshView x:Name="RefreshContainer"
                 Refreshing="OnRefreshRequested">
        <ScrollView>
            <VerticalStackLayout HorizontalOptions="Center"
                                 MaximumWidthRequest="1100"
                                 Spacing="28"
                                 Padding="{OnIdiom Phone='20,18,20,28', Tablet='34,24,34,36', Default='48,28,48,44'}">

                <Border BackgroundColor="White"
                        Padding="{OnIdiom Phone='16', Tablet='20', Default='22'}"
                        Stroke="#E5E0DA"
                        StrokeShape="RoundRectangle 26">
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          RowSpacing="12"
                          ColumnSpacing="18">

                        <VerticalStackLayout Grid.RowSpan="2"
                                             Spacing="6"
                                             WidthRequest="{OnIdiom Phone='92', Default='118'}">
                            <Grid ColumnDefinitions="10,10,10,10"
                                  ColumnSpacing="2"
                                  HorizontalOptions="Start">
                                <BoxView Grid.Column="0" Color="#2444D7" HeightRequest="10" WidthRequest="10" />
                                <BoxView Grid.Column="1" Color="#F7F4EF" HeightRequest="10" WidthRequest="10" />
                                <BoxView Grid.Column="2" Color="#E24242" HeightRequest="10" WidthRequest="10" />
                            </Grid>
                            <Label Text="MINISTERE&#10;DES SOLIDARITES&#10;ET DE LA SANTE"
                                   FontSize="{OnIdiom Phone='9', Default='11'}"
                                   FontAttributes="Bold"
                                   LineHeight="1.0"
                                   TextColor="#111111" />
                            <Label Text="France"
                                   FontSize="10"
                                   TextColor="#585570" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="(RE) Sources Relationnelles"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="{OnIdiom Phone='18', Tablet='24', Default='28'}"
                               TextColor="#2E2AA5" />

                        <Button Grid.Column="2"
                                Text="Menu"
                                Clicked="OnMenuClicked"
                                FontSize="14"
                                WidthRequest="64"
                                HeightRequest="42"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="#2E2AA5" />

                        <HorizontalStackLayout Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               HorizontalOptions="End"
                                               Spacing="18"
                                               IsVisible="{OnIdiom Phone=False, Default=True}">
                            <Label Text="Articles"
                                   Style="{StaticResource HeaderLinkLabelStyle}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticlesHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Evenements"
                                   Style="{StaticResource HeaderLinkLabelStyle}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEventsHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeaderRegisterLabel"
                                   Text="Inscription"
                                   Style="{StaticResource HeaderLinkLabelStyle}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeaderCreateArticleLabel"
                                   Text="Creer un article"
                                   Style="{StaticResource HeaderLinkLabelStyle}"
                                   IsVisible="False">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateArticleHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeaderCreateEventLabel"
                                   Text="Creer un evenement"
                                   Style="{StaticResource HeaderLinkLabelStyle}"
                                   IsVisible="False">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateEventHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeaderLogoutLabel"
                                   Text="Logout"
                                   Style="{StaticResource HeaderLinkLabelStyle}"
                                   IsVisible="False">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="HeaderAccountLabel"
                                   Text="Connexion"
                                   Style="{StaticResource HeaderLinkLabelStyle}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAccountHeaderTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10"
                                     Padding="{OnIdiom Phone='4,4,4,0', Default='10,8,10,0'}">
                    <Label Text="Bienvenue sur (RE) Sources Relationnelles !"
                           Style="{StaticResource Headline}"
                           FontSize="{OnIdiom Phone='28', Default='36'}"
                           TextColor="#1E1C44" />
                    <Label Text="La plateforme d'echange preferee des Francais"
                           Style="{StaticResource SectionCaptionStyle}"
                           FontSize="{OnIdiom Phone='15', Default='17'}"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16"
                          Margin="0,10,0,0">
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <ActivityIndicator x:Name="LoadingIndicator"
                                               IsVisible="False"
                                               IsRunning="False"
                                               VerticalOptions="Center" />
                            <Label x:Name="StatusLabel"
                                   Text="Chargement des ressources publiques..."
                                   Style="{StaticResource SectionCaptionStyle}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button x:Name="ReloadButton"
                                Grid.Column="1"
                                Text="Actualiser"
                                Clicked="OnRefreshButtonClicked"
                                Style="{StaticResource MiniActionButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArticlesHeaderTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Article"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="Selection editoriale publique"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid IsClippedToBounds="True">
                        <CarouselView x:Name="ArticleCarousel"
                                      HeightRequest="{OnIdiom Phone='360', Tablet='395', Default='420'}"
                                      IndicatorView="ArticleIndicator"
                                      IsBounceEnabled="False"
                                      Loop="False"
                                      PeekAreaInsets="0">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{OnIdiom Phone='6,0', Tablet='26,0', Default='56,0'}">
                                        <Border BackgroundColor="White"
                                                Stroke="#E3DDD6"
                                                StrokeShape="RoundRectangle 28"
                                                WidthRequest="{OnIdiom Phone='308', Tablet='560', Default='820'}"
                                                HorizontalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnArticleCardTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="190,*">
                                                <Grid BackgroundColor="#D9D7EA"
                                                      Padding="18">
                                                    <VerticalStackLayout Spacing="8">
                                                        <Border BackgroundColor="#2E2AA5"
                                                                HorizontalOptions="Start"
                                                                Padding="10,4"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 12">
                                                            <Label Text="{Binding Badge}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White" />
                                                        </Border>

                                                        <Label Text="{Binding Meta}"
                                                               HorizontalOptions="End"
                                                               HorizontalTextAlignment="End"
                                                               Style="{StaticResource CardMetaStyle}"
                                                               TextColor="#2D2857" />
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout VerticalOptions="End"
                                                                         Spacing="8">
                                                        <Label Text="{Binding HeroCaption}"
                                                               FontSize="{OnIdiom Phone='28', Default='34'}"
                                                               FontAttributes="Bold"
                                                               TextColor="#5A56A8"
                                                               Opacity="0.7" />
                                                        <Label Text="{Binding Title}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               TextColor="#211D5E" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <VerticalStackLayout Grid.Row="1"
                                                                     Padding="22"
                                                                     Spacing="10">
                                                    <Label Text="{Binding Subtitle}"
                                                           Style="{StaticResource CardMetaStyle}"
                                                           IsVisible="{Binding HasSubtitle}" />
                                                    <Label Text="{Binding Summary}"
                                                           Style="{StaticResource CardSummaryStyle}" />
                                                    <Button Text="Voir +"
                                                            Style="{StaticResource MiniActionButtonStyle}"
                                                            HorizontalOptions="End"
                                                            Clicked="OnArticleSeeMoreClicked" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <Border x:Name="ArticleEmptyState"
                                IsVisible="False"
                                BackgroundColor="#F8F5F2"
                                Stroke="#DFD9D2"
                                StrokeShape="RoundRectangle 24"
                                Padding="24">
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="Aucun article public disponible pour le moment."
                                       HorizontalTextAlignment="Center"
                                       Style="{StaticResource CardSummaryStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <IndicatorView x:Name="ArticleIndicator"
                                   HorizontalOptions="Center"
                                   IndicatorSize="10"
                                   Margin="0,-4,0,0"
                                   IsVisible="False" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEventsHeaderTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Evenement"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="Agenda et rendez-vous a venir"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid IsClippedToBounds="True">
                        <CarouselView x:Name="EventCarousel"
                                      HeightRequest="{OnIdiom Phone='390', Tablet='420', Default='440'}"
                                      IndicatorView="EventIndicator"
                                      IsBounceEnabled="False"
                                      Loop="False"
                                      PeekAreaInsets="0">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{OnIdiom Phone='6,0', Tablet='26,0', Default='56,0'}">
                                        <Border BackgroundColor="White"
                                                Stroke="#E3DDD6"
                                                StrokeShape="RoundRectangle 28"
                                                WidthRequest="{OnIdiom Phone='308', Tablet='560', Default='820'}"
                                                HorizontalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEventCardTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="190,*">
                                                <Grid BackgroundColor="#E5E0DA"
                                                      Padding="18">
                                                    <VerticalStackLayout Spacing="8">
                                                        <Border BackgroundColor="#3B3779"
                                                                HorizontalOptions="Start"
                                                                Padding="10,4"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 12">
                                                            <Label Text="{Binding Badge}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White" />
                                                        </Border>

                                                        <Label Text="{Binding Meta}"
                                                               HorizontalOptions="End"
                                                               HorizontalTextAlignment="End"
                                                               Style="{StaticResource CardMetaStyle}"
                                                               TextColor="#4C496A" />
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout VerticalOptions="End"
                                                                         Spacing="8">
                                                        <Label Text="{Binding HeroCaption}"
                                                               FontSize="{OnIdiom Phone='28', Default='34'}"
                                                               FontAttributes="Bold"
                                                               TextColor="#7B776F"
                                                               Opacity="0.8" />
                                                        <Label Text="{Binding Title}"
                                                               Style="{StaticResource CardTitleStyle}" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <VerticalStackLayout Grid.Row="1"
                                                                     Padding="22"
                                                                     Spacing="10">
                                                    <Label Text="{Binding Subtitle}"
                                                           Style="{StaticResource CardMetaStyle}"
                                                           IsVisible="{Binding HasSubtitle}" />
                                                    <Label Text="{Binding Summary}"
                                                           Style="{StaticResource CardSummaryStyle}" />
                                                    <Button Text="Voir +"
                                                            Style="{StaticResource MiniActionButtonStyle}"
                                                            HorizontalOptions="End"
                                                            Clicked="OnEventSeeMoreClicked" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <Border x:Name="EventEmptyState"
                                IsVisible="False"
                                BackgroundColor="#F8F5F2"
                                Stroke="#DFD9D2"
                                StrokeShape="RoundRectangle 24"
                                Padding="24">
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="Aucun evenement public disponible pour le moment."
                                       HorizontalTextAlignment="Center"
                                       Style="{StaticResource CardSummaryStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <IndicatorView x:Name="EventIndicator"
                                   HorizontalOptions="Center"
                                   IndicatorSize="10"
                                   Margin="0,-4,0,0"
                                   IsVisible="False" />
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        Padding="{OnIdiom Phone='16', Default='22'}"
                        Stroke="#E5E0DA"
                        StrokeShape="RoundRectangle 24"
                        Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="18">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Nous suivre sur les reseaux sociaux"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#2E2AA5" />

                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="#F1EEF9"
                                        Padding="8"
                                        Stroke="#D4CFF0"
                                        StrokeShape="RoundRectangle 18">
                                    <Label Text="X"
                                           TextColor="#2E2AA5"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                                <Border BackgroundColor="#F1EEF9"
                                        Padding="8"
                                        Stroke="#D4CFF0"
                                        StrokeShape="RoundRectangle 18">
                                    <Label Text="f"
                                           TextColor="#2E2AA5"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                                <Border BackgroundColor="#F1EEF9"
                                        Padding="8"
                                        Stroke="#D4CFF0"
                                        StrokeShape="RoundRectangle 18">
                                    <Label Text="in"
                                           TextColor="#2E2AA5"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                                <Border BackgroundColor="#F1EEF9"
                                        Padding="8"
                                        Stroke="#D4CFF0"
                                        StrokeShape="RoundRectangle 18">
                                    <Label Text="ig"
                                           TextColor="#2E2AA5"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">
                            <Label Text="Legal &amp; Contact"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#2E2AA5" />
                            <Label Text="Mentions legales"
                                   Style="{StaticResource SectionCaptionStyle}" />
                            <Label Text="Donnees personnelles et cookies"
                                   Style="{StaticResource SectionCaptionStyle}" />
                            <Label Text="Conditions generales d'utilisation"
                                   Style="{StaticResource SectionCaptionStyle}" />
                            <Label Text="Contacts"
                                   Style="{StaticResource SectionCaptionStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
