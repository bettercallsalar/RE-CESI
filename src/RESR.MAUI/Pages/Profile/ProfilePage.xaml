<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RESR.MAUI.Pages.Profile.ProfilePage"
             Title="Mon profil"
             BackgroundColor="#F4F1EC">

    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#1E1C44" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#6A678A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#2C2C2C" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,28', Tablet='28,22,28,32', Default='36,26,36,40'}"
                             Spacing="18"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="980">

            <Border BackgroundColor="White"
                    Padding="{OnIdiom Phone='18', Default='24'}"
                    Stroke="#D7D7D7"
                    StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mon profil"
                           Style="{StaticResource Headline}"
                           FontSize="{OnIdiom Phone='28', Default='32'}"
                           TextColor="#1E1C44" />
                    <Label Text="Retrouve tes informations, tes favoris et ta liste lire plus tard."
                           Style="{StaticResource SectionCaptionStyle}"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="StatusLabel"
                           Text="Chargement du profil..."
                           Style="{StaticResource SectionCaptionStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="{OnIdiom Phone='18', Default='24'}"
                    Stroke="#D7D7D7"
                    StrokeShape="RoundRectangle 26">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="18"
                      RowSpacing="16">

                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="0"
                                         Spacing="4">
                        <Label Text="Nom d'utilisateur"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="UsernameLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="1"
                                         Spacing="4">
                        <Label Text="Email"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="EmailLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1"
                                         Grid.Column="0"
                                         Spacing="4">
                        <Label Text="Prenom"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="FirstNameLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1"
                                         Grid.Column="1"
                                         Spacing="4">
                        <Label Text="Date de naissance"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="BirthDateLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2"
                                         Grid.Column="0"
                                         Spacing="4">
                        <Label Text="Departement"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="DepartmentLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2"
                                         Grid.Column="1"
                                         Spacing="4">
                        <Label Text="Verifie"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="VerifiedLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="3"
                                         Grid.ColumnSpan="2"
                                         Spacing="4">
                        <Label Text="Biographie"
                               Style="{StaticResource FieldLabelStyle}" />
                        <Label x:Name="BioLabel"
                               Style="{StaticResource FieldValueStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="White"
                    Padding="{OnIdiom Phone='18', Default='24'}"
                    Stroke="#D7D7D7"
                    StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Favoris"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label x:Name="FavoritesEmptyLabel"
                           Text="Aucune ressource en favori."
                           Style="{StaticResource SectionCaptionStyle}" />
                    <VerticalStackLayout x:Name="FavoritesContainer"
                                         Spacing="12" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="{OnIdiom Phone='18', Default='24'}"
                    Stroke="#D7D7D7"
                    StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Lire plus tard"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label x:Name="ReadLaterEmptyLabel"
                           Text="Aucune ressource a lire plus tard."
                           Style="{StaticResource SectionCaptionStyle}" />
                    <VerticalStackLayout x:Name="ReadLaterContainer"
                                         Spacing="12" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Se deconnecter"
                    Clicked="OnLogoutClicked"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
