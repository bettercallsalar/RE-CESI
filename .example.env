MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=resr
MYSQL_USER=resr
MYSQL_PASSWORD=resr
MYSQL_PORT=3306

API_PORT=8080
FRONTEND_PORT=5173
ASPNETCORE_ENVIRONMENT=Development

# URL used by the browser app served by Vite.
# Keep localhost here when accessing the frontend from your machine.
VITE_API_BASE_URL=http://localhost:8080

DB_HOST=db
DB_PORT=3306

JWT_ISSUER=RESR
JWT_AUDIENCE=RESR
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN

# Optional override for the API container build/runtime platform.
# Leave unset on Apple Silicon unless you explicitly need emulation.
# API_DOCKER_PLATFORM=linux/arm64/v8
# API_DOCKER_PLATFORM=linux/amd64
