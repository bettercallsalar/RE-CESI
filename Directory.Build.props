<Project>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Only measure coverage for product assemblies, never the test assemblies -->
    <Include>[RESR.*]*</Include>
    <Exclude>[*Tests*]*</Exclude>
    <ExcludeByFile>**/Program.cs;**/*DependencyInjection*.cs;**/Security/**;**/Microsoft.AspNetCore.OpenApi.SourceGenerators/**;**/*OpenApi*.generated.cs</ExcludeByFile>
    <ExcludeByAttribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
  </PropertyGroup>
</Project>
